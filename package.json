{
  "name": "@mmutils/bench",
  "version": "0.1.0",
  "description": "Microbenchmarks with run time distributions: every call is timed in a fresh worker, with CPU and memory probes, and plotted side by side with @mmutils/logger.",
  "keywords": [
    "benchmark",
    "microbenchmark",
    "performance",
    "histogram",
    "distribution",
    "worker",
    "typescript",
    "mmutils"
  ],
  "author": "Tihomir Trifonov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastermind-0xff/mm-bench.git"
  },
  "homepage": "https://github.com/mastermind-0xff/mm-bench#readme",
  "bugs": {
    "url": "https://github.com/mastermind-0xff/mm-bench/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && rollup -c && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "coverage": "npm run build && vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build",
    "demo": "npm run build && node demo/compare.js",
    "images": "node scripts/readme-images.js"
  },
  "dependencies": {
    "@mmutils/logger": "^0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "rollup": "^4.63.5",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
